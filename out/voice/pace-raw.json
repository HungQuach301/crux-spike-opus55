 "fastSentences": [
  {
   "scene": "hook1",
   "text": "A car loan with twenty-five thousand dollars left, at five point two percent.",
   "words": 13,
   "start": 0,
   "end": 4.14,
   "seconds": 4.14,
   "wpm": 188.4
  },
  {
   "scene": "hook2",
   "text": "Pay it off early, or invest the extra cash?",
   "words": 9,
   "start": 0,
   "end": 2.6,
   "seconds": 2.6,
   "wpm": 207.7
  },
  {
   "scene": "hook4",
   "text": "The answer flips at an average annual return of six point one one percent, compounded, in the twenty-two percent tax bracket.",
   "words": 21,
   "start": 0,
   "end": 6.54,
   "seconds": 6.54,
   "wpm": 192.7
  },
  {
   "scene": "scope1",
   "text": "Here is the setup: the rules are U.S. tax rules, and every input is stated, not forecast.",
   "words": 17,
   "start": 0,
   "end": 5.74,
   "seconds": 5.74,
   "wpm": 177.7
  },
  {
   "scene": "facts",
   "text": "The loan has twenty-five thousand dollars left at five point two percent, with forty-eight monthly payments of five hundred seventy-eight dollars.",
   "words": 21,
   "start": 0,
   "end": 7,
   "seconds": 7,
   "wpm": 180
  },
  {
   "scene": "extra",
   "text": "On top of that, four hundred dollars a month is available.",
   "words": 11,
   "start": 0,
   "end": 2.72,
   "seconds": 2.72,
   "wpm": 242.6
  },
  {
   "scene": "extra",
   "text": "That amount is illustrative.",
   "words": 4,
   "start": 3.34,
   "end": 4.7,
   "seconds": 1.36,
   "wpm": 176.5
  },
  {
   "scene": "roads",
   "text": "Road A sends it to the loan.",
   "words": 7,
   "start": 0,
   "end": 1.84,
   "seconds": 1.84,
   "wpm": 228.3
  },
  {
   "scene": "roads",
   "text": "Road B pays the minimum and invests it every month.",
   "words": 10,
   "start": 2.54,
   "end": 5.56,
   "seconds": 3.02,
   "wpm": 198.7
  },
  {
   "scene": "cash",
   "text": "Only the order changes.",
   "words": 4,
   "start": 3.64,
   "end": 4.66,
   "seconds": 1.02,
   "wpm": 235.3
  },
  {
   "scene": "timeline",
   "text": "Road A pays off the loan at month twenty-eight.",
   "words": 9,
   "start": 0,
   "end": 2.7,
   "seconds": 2.7,
   "wpm": 200
  },
  {
   "scene": "interest",
   "text": "Interest paid falls from two thousand seven hundred forty-four dollars to one thousand five hundred fifty-four dollars.",
   "words": 17,
   "start": 0,
   "end": 5.68,
   "seconds": 5.68,
   "wpm": 179.6
  },
  {
   "scene": "avoided",
   "text": "That does not depend on markets or taxes.",
   "words": 8,
   "start": 4.66,
   "end": 7.16,
   "seconds": 2.5,
   "wpm": 192
  },
  {
   "scene": "bridge",
   "text": "So the question is narrow: can road B's head start in the market beat a certain one thousand one hundred ninety dollars, after tax?",
   "words": 24,
   "start": 0,
   "end": 7.12,
   "seconds": 7.12,
   "wpm": 202.2
  },
  {
   "scene": "lots1",
   "text": "At month forty-eight, everything is sold.",
   "words": 6,
   "start": 3.54,
   "end": 5.48,
   "seconds": 1.94,
   "wpm": 185.6
  },
  {
   "scene": "lots2",
   "text": "A lot held more than twelve months at that sale is long-term.",
   "words": 12,
   "start": 0,
   "end": 3.8,
   "seconds": 3.8,
   "wpm": 189.5
  },
  {
   "scene": "lots3",
   "text": "Road A starts after the payoff: eight of its twenty-one.",
   "words": 10,
   "start": 5.94,
   "end": 9.16,
   "seconds": 3.22,
   "wpm": 186.3
  },
  {
   "scene": "nodeduct",
   "text": "A lot that loses money gets no deduction.",
   "words": 8,
   "start": 0,
   "end": 2.06,
   "seconds": 2.06,
   "wpm": 233
  },
  {
   "scene": "nodeduct",
   "text": "State income tax is left out.",
   "words": 6,
   "start": 2.9,
   "end": 4.28,
   "seconds": 1.38,
   "wpm": 260.9
  },
  {
   "scene": "card3",
   "text": "Third, where the answer flips.",
   "words": 5,
   "start": 0,
   "end": 1.42,
   "seconds": 1.42,
   "wpm": 211.3
  },
  {
   "scene": "sw2",
   "text": "The line is road B minus road A, net worth after tax at month forty-eight, and it rises with the return.",
   "words": 21,
   "start": 0,
   "end": 7.04,
   "seconds": 7.04,
   "wpm": 179
  },
  {
   "scene": "sw3",
   "text": "At two percent, road A is ahead by eight hundred twenty-two dollars.",
   "words": 12,
   "start": 0,
   "end": 3.64,
   "seconds": 3.64,
   "wpm": 197.8
  },
  {
   "scene": "sw3",
   "text": "At ten percent, road B is ahead by eight hundred sixty-one dollars.",
   "words": 12,
   "start": 4.46,
   "end": 8.18,
   "seconds": 3.72,
   "wpm": 193.5
  },
  {
   "scene": "sw4",
   "text": "Both roads end even at six point one one percent.",
   "words": 10,
   "start": 0,
   "end": 3.4,
   "seconds": 3.4,
   "wpm": 176.5
  },
  {
   "scene": "dots",
   "text": "The break-even is five point two three percent in the twelve percent bracket, and six point one one percent in the twenty-two percent bracket.",
   "words": 24,
   "start": 0,
   "end": 7.58,
   "seconds": 7.58,
   "wpm": 190
  },
  {
   "scene": "dots32",
   "text": "In the thirty-two percent bracket, it is six point two six percent.",
   "words": 12,
   "start": 0,
   "end": 3.82,
   "seconds": 3.82,
   "wpm": 188.5
  },
  {
   "scene": "below",
   "text": "In the twelve percent bracket it sits below five point three three percent, the loan rate as an annual yield, because road A's gains are mostly short-term.",
   "words": 27,
   "start": 0,
   "end": 9.06,
   "seconds": 9.06,
   "wpm": 178.8
  },
  {
   "scene": "order",
   "text": "The order of the returns decided the result.",
   "words": 8,
   "start": 6.08,
   "end": 8.38,
   "seconds": 2.3,
   "wpm": 208.7
  },
  {
   "scene": "recap",
   "text": "The tax depends on how long each lot is held.",
   "words": 10,
   "start": 3.66,
   "end": 6.26,
   "seconds": 2.6,
   "wpm": 230.8
  },
  {
   "scene": "recap",
   "text": "The return is the unknown.",
   "words": 5,
   "start": 6.94,
   "end": 8.4,
   "seconds": 1.46,
   "wpm": 205.5
  },
  {
   "scene": "end1",
   "text": "So, in the twenty-two percent bracket, the answer flips at an average annual return of six point one one percent, compounded.",
   "words": 21,
   "start": 0,
   "end": 7.08,
   "seconds": 7.08,
   "wpm": 178
  },
  {
   "scene": "end2",
   "text": "That is a threshold, not a forecast.",
   "words": 7,
   "start": 0,
   "end": 2.08,
   "seconds": 2.08,
   "wpm": 201.9
  },
  {
   "scene": "end2",
   "text": "Where returns will land is not known in advance.",
   "words": 9,
   "start": 2.72,
   "end": 5.16,
   "seconds": 2.44,
   "wpm": 221.3
  }
 ],
